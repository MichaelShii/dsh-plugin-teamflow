{
  "version": 1,
  "note": "TeamFlow L2 回放语料清单：冻结真实形状的阶段产物（含历史实证坑），改 prompt/解析器后跑 test/conformance.test.js 验证 host 解析边界不回归。parser 必须是 test/conformance.test.js 支持的真实解析器。语料文件只增不改（改动 = 新文件 + 新条目，保留历史样本）。",
  "parsers": {
    "parseDefects": "host/core/backlog.ts（QA 缺陷表 → 结构化缺陷；容忍 **P1** 加粗、跳过表头/OBS）",
    "parseAcceptanceVerdict": "host/util.ts（验收报告 → accepted/rework/reject/needs-human）",
    "extractVerificationEvidence": "host/util.ts（dev/qaFix 回复 → 证据块原文或 null）",
    "extractBlueprint": "host/util.ts（tech/architect 产出 → 架构蓝图对象或 null；含畸形 JSON 抢救）",
    "judgeDeliverable": "host/util.ts（阶段产出 → 交付判定 {ok,reason,refusal}；信号分级=客观形态→证据块→措辞兜底）",
    "extractHostResearchSection": "host/util.ts（PRD → 「宿主契约调研」段原文或 null；非 dsh 宿主 + 插件形态时的硬门禁判据）"
  },
  "cases": [
    {
      "id": "qa-defects-p1-bold",
      "file": "qa-report-defects.md",
      "parser": "parseDefects",
      "note": "BUG-P1-1 打回形态：**P1** 加粗严重级必须解析到；OBS 观察项跳过",
      "expect": [
        { "id": "BUG-1", "severity": "P1", "module": "persist.js" },
        { "id": "BUG-2", "severity": "P2", "module": "audio.js" }
      ]
    },
    {
      "id": "qa-no-defects",
      "file": "qa-report-no-defects.md",
      "parser": "parseDefects",
      "note": "「未发现缺陷」报告 → 空数组（表头/结论行不误登）",
      "expect": []
    },
    {
      "id": "acc-pass",
      "file": "acceptance-pass.md",
      "parser": "parseAcceptanceVerdict",
      "note": "结论行 ✅ 通过 → accepted",
      "expect": "accepted"
    },
    {
      "id": "acc-pass-noise-word",
      "file": "acceptance-pass-noise-word.md",
      "parser": "parseAcceptanceVerdict",
      "note": "回归陷阱 tf-msytlok5：正文散文「无需改动」不触发 reject（只认结论行）",
      "expect": "accepted"
    },
    {
      "id": "acc-rework-arch",
      "file": "acceptance-rework-arch.md",
      "parser": "parseAcceptanceVerdict",
      "note": "M3 架构门禁：功能绿但重复适配器 → rework（⚠️ 有条件通过 + 架构红词）",
      "expect": "rework"
    },
    {
      "id": "acc-no-conclusion",
      "file": "acceptance-no-conclusion.md",
      "parser": "parseAcceptanceVerdict",
      "note": "无结论行 → needs-human（漏报护栏，不猜结论）",
      "expect": "needs-human"
    },
    {
      "id": "acc-reject-not-applicable",
      "file": "acceptance-reject-not-applicable.md",
      "parser": "parseAcceptanceVerdict",
      "note": "📝 需求不适用 → reject（ADR-0005 拦截形态）",
      "expect": "reject"
    },
    {
      "id": "dev-evidence-present",
      "file": "dev-reply-evidence.md",
      "parser": "extractVerificationEvidence",
      "note": "证据块整体提取（含 cmd 行；state 块前截断）",
      "expect": { "contains": ["node test/verify-persist.cjs", "12/12 passed"] }
    },
    {
      "id": "dev-evidence-missing",
      "file": "dev-reply-no-evidence.md",
      "parser": "extractVerificationEvidence",
      "note": "无 [Verification evidence] 块 → null（契约未兑现，r33 实证）",
      "expect": null
    },
    {
      "id": "tech-blueprint-malformed",
      "file": "tech-blueprint-malformed.md",
      "parser": "extractBlueprint",
      "note": "畸形蓝图 JSON（duplications 后提前闭合，tf-mt85o5jj）→ 抢救解析出 2 任务",
      "expect": { "nonNull": true, "taskCount": 2, "summaryContains": "persist.js" }
    },
    {
      "id": "dev-delivery-env-limitation",
      "file": "dev-reply-env-limitation.md",
      "parser": "judgeDeliverable",
      "note": "假阳性回归（assetd tf-mtwvwpxa-p3vw08 的 T5）：如实汇报「无法执行」的环境限制 + 证据块齐全 → 仍判交付；命中措辞回传留痕",
      "expect": { "ok": true, "reason": "ok", "refusalPhrase": "无法执行" }
    },
    {
      "id": "dev-delivery-bare-refusal",
      "file": "dev-reply-refusal-bare.md",
      "parser": "judgeDeliverable",
      "note": "兜底未被削弱：无证据块 + 拒绝措辞（且只有 state 块）→ 判未交付 reason=refusal",
      "expect": { "ok": false, "reason": "refusal" }
    },
    {
      "id": "acc-en-pass",
      "file": "acceptance-en-pass.md",
      "parser": "parseAcceptanceVerdict",
      "note": "en 结论行（新增识别，AC-6）：Acceptance verdict: ✅ Pass → accepted",
      "expect": "accepted"
    },
    {
      "id": "acc-en-rework",
      "file": "acceptance-en-rework.md",
      "parser": "parseAcceptanceVerdict",
      "note": "en 打回：Acceptance verdict: ❌ Fail → rework",
      "expect": "rework"
    },
    {
      "id": "acc-en-not-applicable",
      "file": "acceptance-en-not-applicable.md",
      "parser": "parseAcceptanceVerdict",
      "note": "en 等价物（ADR-0005 拦截形态）：Acceptance verdict: 📝 Not applicable → reject",
      "expect": "reject"
    },
    {
      "id": "qa-en-defects-p1-bold",
      "file": "qa-report-en-defects.md",
      "parser": "parseDefects",
      "note": "en 缺陷表位置式解析：en 表头跳过、**P1** 加粗命中、OBS 观察项跳过",
      "expect": [
        { "id": "BUG-1", "severity": "P1", "module": "persist.js" },
        { "id": "BUG-2", "severity": "P2", "module": "audio.js" }
      ]
    },
    {
      "id": "qa-en-reverify-table-not-defects",
      "file": "qa-report-en-reverify-table.md",
      "parser": "parseDefects",
      "note": "2026-09-15 停线回归（tf-mu2ioilr-95l4th）：复验对照表（第 2 列 P 级 + 第 3 列结论「已关闭」）整表不得登记；只有带严重级表头的标准缺陷表被解析（R3-1/R3-3 两条 P3），OBS 跳过",
      "expect": [
        { "id": "R3-1", "severity": "P3", "module": "logging" },
        { "id": "R3-3", "severity": "P3", "module": "tools" }
      ]
    },
    {
      "id": "dev-en-evidence-present",
      "file": "dev-reply-en-evidence.md",
      "parser": "extractVerificationEvidence",
      "note": "en 回复的证据块同样整体提取（[Verification evidence] 为 ASCII，中英通用）",
      "expect": { "contains": ["node test/verify-persist.cjs", "12/12 passed"] }
    },
    {
      "id": "dev-en-bare-refusal",
      "file": "dev-reply-en-refusal.md",
      "parser": "judgeDeliverable",
      "note": "en 兜底不得失效：无证据块 + `I cannot`/`not able to` 命中拒绝措辞 → 判未交付",
      "expect": { "ok": false, "reason": "refusal", "refusalPhrase": "I cannot" }
    },
    {
      "id": "qa-check-columns-and-escaped-pipe",
      "file": "qa-report-check-columns.md",
      "parser": "parseDefects",
      "note": "2026-09-15 B 方案（缺陷行新增「检测命令/通过判据」两列）：多出来的两列不得错列；单元格内转义管道符 `\\|` 必须还原成字面量而不是切开单元格（R3-2 错列实锤的回归门禁）；复验对照表仍整表跳过；OBS 观察项跳过",
      "expect": [
        { "id": "R2-1", "severity": "P2", "module": "prompt 语言面" },
        { "id": "R2-2", "severity": "P1", "module": "缺陷解析面" },
        { "id": "R2-3", "severity": "P1", "module": "运行时" }
      ]
    },
    {
      "id": "host-research-present",
      "file": "prd-host-research-openclaw.md",
      "parser": "extractHostResearchSection",
      "note": "2026-09-18 宿主维度：非 dsh 宿主（openclaw）的 PRD 带「宿主契约调研」段 → 摘出正文（编号标题 `## 7.` 也要认，与 extractAssumptionsSection 同源的坑）",
      "expect": { "contains": ["目标宿主", "openclaw", "未能核实"] }
    },
    {
      "id": "host-research-missing",
      "file": "prd-host-research-missing.md",
      "parser": "extractHostResearchSection",
      "note": "契约未兑现的真实形状：别的宿主的插件 PRD 却没有任何调研段 → null（硬门禁据此判 PRD 阶段失败）",
      "expect": null
    },
    {
      "id": "host-research-empty-heading",
      "file": "prd-host-research-empty.md",
      "parser": "extractHostResearchSection",
      "note": "最隐蔽的漏做：标题在、正文空 → 必须判 null（否则模型学会「只写标题」就能过门禁；与假设段同一判定纪律）",
      "expect": null
    }
  ]
}
